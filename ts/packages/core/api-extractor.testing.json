{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "../../api-extractor.base.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/dist/testing.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "core-testing",
    "reportFolder": "<projectFolder>/api/",
    "reportTempFolder": "<projectFolder>/dist/api-tmp/"
  },
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": ["es2023"],
        "strict": true,
        "skipLibCheck": true,
        "types": [],
        "paths": {
          "@libo11y/spec": ["../spec/dist/index.d.ts"],
          "@libo11y/spec/yaml": ["../spec/dist/yaml.d.ts"]
        }
      },
      "include": ["dist"]
    }
  }
}
