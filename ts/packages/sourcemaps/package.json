{
  "name": "@libo11y/sourcemaps",
  "version": "0.3.0",
  "private": true,
  "description": "Uploads JavaScript source maps to the libo11y RUM gateway so it can symbolicate browser and React Native stack traces. A library and the libo11y-sourcemaps command for Bun and Node.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "libo11y-sourcemaps": "./src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesainslie/libo11y.git",
    "directory": "ts/packages/sourcemaps"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "devDependencies": {
    "@libo11y/test": "workspace:*"
  }
}
