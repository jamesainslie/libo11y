{
  "name": "@libo11y/react-native",
  "version": "0.4.0",
  "private": true,
  "description": "The libo11y React Native platform for TypeScript: setup over the OpenTelemetry JS 3.x providers on Hermes, the mobile resource, an OTLP/HTTP transport with a persistent retry queue on device storage, AppState flushing, the consent gate, and fetch and XHR spans.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/expo.ts",
    "./env": "./src/env.ts",
    "./internal": "./src/internal.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesainslie/libo11y.git",
    "directory": "ts/packages/react-native"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "api": "api-extractor run --local && api-extractor run --local -c api-extractor.expo.json",
    "api:check": "api-extractor run && api-extractor run -c api-extractor.expo.json"
  },
  "dependencies": {
    "@libo11y/core": "workspace:*",
    "@libo11y/spec": "workspace:*",
    "@libo11y/web": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1"
  },
  "peerDependencies": {
    "expo-application": ">=58.0.0",
    "expo-device": ">=58.0.0",
    "expo-file-system": ">=58.0.0",
    "expo-updates": ">=58.0.0",
    "react-native": ">=0.88.0"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libo11y/test": "workspace:*",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-native": "0.88.1"
  }
}
