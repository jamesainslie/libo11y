{
  "name": "@libo11y/webext",
  "version": "0.4.0",
  "private": true,
  "description": "The libo11y Manifest V3 extension platform for TypeScript: setup for the service worker with a queue persisted to IndexedDB on every batch, setup for content scripts and extension pages that forward their records to the worker by runtime messaging, and trace context that crosses with every message.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesainslie/libo11y.git",
    "directory": "ts/packages/webext"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "api": "api-extractor run --local && api-extractor run --local -c api-extractor.internal.json",
    "api:check": "api-extractor run && api-extractor run -c api-extractor.internal.json"
  },
  "dependencies": {
    "@libo11y/core": "workspace:*",
    "@libo11y/spec": "workspace:*",
    "@libo11y/web": "workspace:*",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.10.0 <1.11.0"
  },
  "devDependencies": {
    "@libo11y/test": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "fake-indexeddb": "6.2.7"
  }
}
