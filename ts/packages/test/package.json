{
  "name": "@libo11y/test",
  "version": "0.1.1",
  "private": true,
  "description": "The libo11y test harness for TypeScript: a hermetic recorder with conformance and correlation assertions, and an in-process OTLP/HTTP sink. Runs on Bun and Node.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesainslie/libo11y.git",
    "directory": "ts/packages/test"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "api": "api-extractor run --local",
    "api:check": "api-extractor run"
  },
  "dependencies": {
    "@libo11y/core": "workspace:*",
    "@libo11y/spec": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1"
  },
  "devDependencies": {
    "@opentelemetry/otlp-transformer": "0.301.1"
  }
}
