{
  "name": "@libo11y/spec",
  "version": "0.1.2",
  "private": true,
  "description": "The libo11y telemetry specification for TypeScript: attribute keys, enums, event and metric names, and the sensitivity tables, generated from spec/registry.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./yaml": "./src/yaml.ts"
  },
  "bin": {
    "libo11y": "./src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesainslie/libo11y.git",
    "directory": "ts/packages/spec"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "api": "api-extractor run --local && api-extractor run --local -c api-extractor.yaml.json",
    "api:check": "api-extractor run && api-extractor run -c api-extractor.yaml.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
