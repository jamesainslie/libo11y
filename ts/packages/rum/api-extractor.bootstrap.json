{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "../../api-extractor.base.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/dist/bootstrap.d.ts",
  "apiReport": {
    "enabled": true,
    "reportFileName": "rum-bootstrap",
    "reportFolder": "<projectFolder>/api/",
    "reportTempFolder": "<projectFolder>/dist/api-tmp/"
  },
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": ["es2023", "dom", "dom.iterable"],
        "strict": true,
        "skipLibCheck": true,
        "types": [],
        "paths": {
          "@libo11y/core": ["./node_modules/@libo11y/core/dist/index.d.ts"],
          "@libo11y/spec": ["./node_modules/@libo11y/spec/dist/index.d.ts"],
          "@libo11y/web": ["./node_modules/@libo11y/web/dist/index.d.ts"],
          "@libo11y/web/internal": ["./node_modules/@libo11y/web/dist/internal/index.d.ts"]
        },
        "preserveSymlinks": true
      },
      "include": ["dist"]
    }
  }
}
