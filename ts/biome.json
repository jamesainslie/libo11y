{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      "!packages/*/src/generated",
      "!packages/*/api",
      "!packages/sourcemaps/src/e2e/fixtures/*.min.js"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 110 },
  "linter": { "rules": { "preset": "recommended" } }
}
