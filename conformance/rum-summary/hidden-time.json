{
  "description": "Time on view counts only while the page is visible.",
  "platform": "web",
  "steps": [
    {
      "at": 0,
      "do": "open",
      "view": {
        "id": "v0",
        "name": "/",
        "kind": "initial",
        "sessionId": "s1"
      }
    },
    {
      "at": 2000,
      "do": "hide"
    },
    {
      "at": 10000,
      "do": "show"
    },
    {
      "at": 10500,
      "do": "close",
      "viewId": "v0"
    }
  ],
