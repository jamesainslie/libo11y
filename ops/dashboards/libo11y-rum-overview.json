{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Traffic, errors, frustration and Core Web Vitals derived by the o11yrum gateway.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "targetBlank": false,
      "title": "Web vitals",
      "type": "link",
      "url": "/d/libo11y-rum-vitals?${app:queryparam}&${__url_time_range}"
    },
    {
      "targetBlank": false,
      "title": "Errors and frustration",
      "type": "link",
      "url": "/d/libo11y-rum-errors?${app:queryparam}&${platform:queryparam}&${__url_time_range}"
    },
    {
      "targetBlank": false,
      "title": "Gateway",
      "type": "link",
      "url": "/d/libo11y-rum-gateway?${__url_time_range}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Views started per minute, averaged over the time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__rate_interval])) * 60",
          "instant": false,
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Views per minute",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Errors over the time range for every 100 views.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum(increase(o11y_rum_errors_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__range])) / sum(increase(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Errors per 100 views",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Frustration signals (rage, dead and error clicks) over the time range for every 100 views.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum(increase(o11y_rum_frustrations_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__range])) / sum(increase(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Frustrations per 100 views",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The 75th percentile of LCP over the time range, colored by the specification's rating thresholds. Vitals carry no platform label, so this panel ignores the platform picker.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2.5
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.75, sum by (le) (increase(o11y_rum_vital_lcp_seconds_bucket{service_name=~\"$app\"}[$__range])))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "LCP p75",
      "transformations": [],
      "type": "stat"
    },
