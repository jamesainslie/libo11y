        "uid": "${prometheus}"
      },
      "description": "The share of LCP samples the gateway rated good, needs-improvement and poor over the time range. Vitals carry no platform label, so this panel ignores the platform picker.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "good"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "needs-improvement"
