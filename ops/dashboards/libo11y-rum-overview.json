          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(o11y_rum_browser_long_animation_frames_total{service_name=~\"$app\"}[$__rate_interval])) / sum(rate(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"web|webext\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "frames per view",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Long animation frames per view",
      "transformations": [],
      "type": "timeseries"
