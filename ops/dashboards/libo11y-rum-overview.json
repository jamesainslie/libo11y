          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11y_rum_platform) (rate(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\"}[$__rate_interval]))",
