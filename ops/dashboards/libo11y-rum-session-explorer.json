{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "One RUM session's views, events, traces and spans, by session.id and o11y.rum.view.id.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "targetBlank": false,
      "title": "Errors and frustration",
      "type": "link",
      "url": "/d/libo11y-rum-errors?${app:queryparam}&${__url_time_range}"
    }
  ],
  "panels": [
    {
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**How to use.** Paste a `session.id` into the session.id box, or open a session from the errors and frustration dashboard. Then pick a view from \"Views in this session\" to fill o11y.rum.view.id. Every RUM span and event carries `session.id`, and views and their events carry `o11y.rum.view.id` (RUM.md). Loki keeps both as structured metadata, never as stream labels, and Tempo keeps them as span attributes.",
        "mode": "markdown"
      },
      "targets": [],
      "title": "How to use",
      "transformations": [],
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The session's views, from their view summaries. Open a row to show that view below.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Select this view",
              "url": "/d/libo11y-rum-session-explorer?${session_id:queryparam}&var-view_id=${__data.fields.o11y_rum_view_id:percentencode}&${app:queryparam}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "summaries"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (o11y_rum_view_id, o11y_rum_view_name, o11y_rum_view_kind) (count_over_time({service_name=~\"$app\"} | session_id!=\"\" | session_id=\"$session_id\" | event_name=\"o11y.rum.view.summary\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Views in this session",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "description": "The session's traces. A fetch span's backend children share its trace, so backend spans come with it.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "id": 3,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "limit": 100,
          "query": "{ span.session.id = \"$session_id\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Traces in this session",
      "transformations": [],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Every event of the session, oldest first.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"$app\"} | session_id!=\"\" | session_id=\"$session_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Session timeline",
      "transformations": [],
      "type": "logs"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "description": "The spans of the selected view. Empty until view_id (o11y.rum.view.id) is set.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          },
          "limit": 200,
          "query": "{ span.session.id = \"$session_id\" && span.o11y.rum.view.id = \"$view_id\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Spans of the selected view",
      "transformations": [],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The events of the selected view, oldest first. Empty until view_id (o11y.rum.view.id) is set.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"$app\"} | session_id!=\"\" | session_id=\"$session_id\" | o11y_rum_view_id!=\"\" | o11y_rum_view_id=\"$view_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Events of the selected view",
      "transformations": [],
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The session's error and frustration events, oldest first.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"$app\"} | session_id!=\"\" | session_id=\"$session_id\" | event_name=~\"o11y\\\\.rum\\\\.(error|frustration)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors and frustration in this session",
      "transformations": [],
      "type": "logs"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "libo11y",
    "rum"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Loki",
        "name": "loki",
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "label": "Tempo",
        "name": "tempo",
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "label_values(service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "App",
        "multi": true,
        "name": "app",
        "query": "label_values(service_name)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "label": "session.id",
        "name": "session_id",
        "query": "",
        "type": "textbox"
      },
      {
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "label": "o11y.rum.view.id",
        "name": "view_id",
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "title": "libo11y RUM: session explorer",
  "uid": "libo11y-rum-session-explorer",
  "version": 1
}
