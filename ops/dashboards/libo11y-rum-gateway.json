{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "The o11yrum gateway's own telemetry: requests, rejections, validation, sinks, the derived metric aggregator and symbolication.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "targetBlank": false,
      "title": "Overview",
      "type": "link",
      "url": "/d/libo11y-rum-overview?${__url_time_range}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "OTLP requests the gateway handled per second, averaged over the time range, whatever their outcome.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests per second",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The share of requests the gateway refused over the time range, for any reason. Rejections by reason below tells a misconfigured origin from rate limiting or a failing sink.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\", o11yrum_outcome=\"rejected\"}[$__range])) / sum(increase(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Rejected share",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The 99th percentile of one export to a sink over the time range, across every sink. The app picker does not apply: sink exports carry no app label.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (increase(o11yrum_sink_duration_seconds_bucket{job=~\"$gateway\"}[$__range])))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Sink p99",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Attribute sets the derived metric aggregator holds now, across every metric and app. The app picker does not apply.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(o11yrum_aggregator_series{job=~\"$gateway\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Aggregator series",
      "transformations": [],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Requests per second by outcome: accepted, partial (some records dropped by validation) or rejected.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_outcome) (rate(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests by outcome",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Requests per second by OTLP signal.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_signal) (rate(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_signal}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests by signal",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Refused requests per second by reason. origin and client_token point at configuration, rate_limited at a busy client, sink at a failing backend.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_reason) (rate(o11yrum_batches_total{job=~\"$gateway\", o11yrum_app=~\"$app\", o11yrum_outcome=\"rejected\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Rejections by reason",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Records validation removed from accepted requests, per second, by reason.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_reason) (rate(o11yrum_records_dropped_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_reason}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Records dropped by reason",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "The median and 99th percentile of one export, by sink. The app picker does not apply.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, o11yrum_sink) (rate(o11yrum_sink_duration_seconds_bucket{job=~\"$gateway\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p50 {{o11yrum_sink}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, o11yrum_sink) (rate(o11yrum_sink_duration_seconds_bucket{job=~\"$gateway\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "p99 {{o11yrum_sink}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Sink latency",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Exports per second by sink and outcome. The app picker does not apply.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_sink, o11yrum_outcome) (rate(o11yrum_sink_duration_seconds_count{job=~\"$gateway\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_sink}} {{o11yrum_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Sink exports by outcome",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Attributes the attribute policy removed per second, by app: o11y.* keys the specification does not define, and keys past the limits.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_app) (rate(o11yrum_attributes_removed_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_app}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Attributes removed by policy",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Attribute sets each derived metric holds, summed across apps. Each app may hold aggregation.max_series_per_metric (default 2000) in one metric before its measurements go to the overflow series. The app picker does not apply.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_metric) (o11yrum_aggregator_series{job=~\"$gateway\"})",
          "instant": false,
          "legendFormat": "{{o11yrum_metric}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Aggregator series by metric",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Stack frames symbolication handled per second: hit (resolved), unmapped (no mapping at the position), miss (no map for the script), error (the map could not be read) and skipped (no release, or over a batch's budget). A rise in miss usually means a release went out before its maps were uploaded.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "id": 13,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_result) (rate(o11yrum_symbolication_frames_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{o11yrum_result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Symbolicated frames by result",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Source map uploads over the time range, by app and outcome. unauthorized uploads name app unknown when the service is not configured.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "uploads"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "id": 14,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "uploads"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (o11yrum_app, o11yrum_outcome) (increase(o11yrum_sourcemaps_uploads_total{job=~\"$gateway\", o11yrum_app=~\"$app\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Source map uploads by outcome",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "libo11y",
    "rum",
    "gateway"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "prometheus",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(o11yrum_batches_total, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Gateway",
        "multi": true,
        "name": "gateway",
        "query": {
          "query": "label_values(o11yrum_batches_total, job)",
          "refId": "Var"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(o11yrum_batches_total{job=~\"$gateway\"}, o11yrum_app)",
        "hide": 0,
        "includeAll": true,
        "label": "App",
        "multi": true,
        "name": "app",
        "query": {
          "query": "label_values(o11yrum_batches_total{job=~\"$gateway\"}, o11yrum_app)",
          "refId": "Var"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "libo11y RUM: gateway",
  "uid": "libo11y-rum-gateway",
  "version": 1
}
