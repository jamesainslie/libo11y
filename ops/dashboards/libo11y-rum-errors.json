{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Error and frustration rates for every consented session, and the events of kept sessions from Loki.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "targetBlank": false,
      "title": "Overview",
      "type": "link",
      "url": "/d/libo11y-rum-overview?${app:queryparam}&${platform:queryparam}&${__url_time_range}"
    },
    {
      "targetBlank": false,
      "title": "Session explorer",
      "type": "link",
      "url": "/d/libo11y-rum-session-explorer?${app:queryparam}&${__url_time_range}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum by (o11y_rum_error_source) (rate(o11y_rum_errors_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__rate_interval])) / scalar(sum(rate(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{o11y_rum_error_source}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Errors per 100 views by source",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "100 * sum by (o11y_rum_frustration_type) (rate(o11y_rum_frustrations_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__rate_interval])) / scalar(sum(rate(o11y_rum_views_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{o11y_rum_frustration_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Frustrations per 100 views by type",
      "transformations": [],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "errors"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "errors"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "topk(20, sum by (service_name, o11y_rum_view_name) (increase(o11y_rum_errors_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Views with the most errors",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "frustrations"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "frustrations"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "topk(20, sum by (service_name, o11y_rum_view_name) (increase(o11y_rum_frustrations_total{service_name=~\"$app\", o11y_rum_platform=~\"$platform\", o11y_rum_view_name=~\"$view\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Views with the most frustration",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The 50 most frequent errors over the time range, grouped by fingerprint. Error and frustration events reach Loki only for kept sessions, while the Prometheus panels count every consented session.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "events"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "events"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(50, sum by (o11y_rum_error_fingerprint, exception_type, o11y_rum_error_source) (count_over_time({service_name=~\"$app\"} | event_name=\"o11y.rum.error\" [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error inbox (kept sessions)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The UI elements with the most frustration signals over the time range. Error and frustration events reach Loki only for kept sessions, while the Prometheus panels count every consented session.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "events"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 6,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "events"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(20, sum by (o11y_rum_frustration_type, o11y_rum_element_selector) (count_over_time({service_name=~\"$app\"} | event_name=\"o11y.rum.frustration\" [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Most frustrated elements (kept sessions)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "The sessions with the most error and frustration events. Open a row in the session explorer. Error and frustration events reach Loki only for kept sessions, while the Prometheus panels count every consented session.",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open in the session explorer",
              "url": "/d/libo11y-rum-session-explorer?var-session_id=${__data.fields.session_id:percentencode}&${app:queryparam}&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "events"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "events"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(50, sum by (session_id) (count_over_time({service_name=~\"$app\"} | event_name=~\"o11y\\\\.rum\\\\.(error|frustration)\" [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Sessions with errors or frustration",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Error events, newest first. Error and frustration events reach Loki only for kept sessions, while the Prometheus panels count every consented session.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=~\"$app\"} | event_name=\"o11y.rum.error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent errors",
      "transformations": [],
      "type": "logs"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "libo11y",
    "rum"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "prometheus",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "label": "Loki",
        "name": "loki",
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": "",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(o11y_rum_views_total, service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "App",
        "multi": true,
        "name": "app",
        "query": {
          "query": "label_values(o11y_rum_views_total, service_name)",
          "refId": "Var"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(o11y_rum_views_total{service_name=~\"$app\"}, o11y_rum_platform)",
        "hide": 0,
        "includeAll": true,
        "label": "Platform",
        "multi": true,
        "name": "platform",
        "query": {
          "query": "label_values(o11y_rum_views_total{service_name=~\"$app\"}, o11y_rum_platform)",
          "refId": "Var"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(o11y_rum_views_total{service_name=~\"$app\"}, o11y_rum_view_name)",
        "hide": 0,
        "includeAll": true,
        "label": "View",
        "multi": true,
        "name": "view",
        "query": {
          "query": "label_values(o11y_rum_views_total{service_name=~\"$app\"}, o11y_rum_view_name)",
          "refId": "Var"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "libo11y RUM: errors and frustration",
  "uid": "libo11y-rum-errors",
  "version": 1
}
