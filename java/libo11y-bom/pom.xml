<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ing.o11y</groupId>
    <artifactId>libo11y-bom</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>libo11y Java BOM</name>
    <description>Bill of Materials for libo11y Java modules.</description>
    <url>https://o11y.ing</url>
    <inceptionYear>2026</inceptionYear>

    <!-- The BOM has no parent, so importing it brings in nothing but the
         libo11y versions. It repeats the project metadata for that reason. -->
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>jamesainslie</id>
            <name>James Ainslie</name>
            <url>https://github.com/jamesainslie</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/jamesainslie/libo11y.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jamesainslie/libo11y.git</developerConnection>
        <url>https://github.com/jamesainslie/libo11y/tree/main/java</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/jamesainslie/libo11y/issues</url>
    </issueManagement>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-spec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
