<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ing.o11y</groupId>
    <artifactId>libo11y-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>libo11y Java</name>
    <description>Opinionated OpenTelemetry, Micrometer, and Spring Boot observability library for Java.</description>
    <url>https://o11y.ing</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-boot.version>4.2.0</spring-boot.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    </properties>

    <modules>
        <module>libo11y-bom</module>
        <module>libo11y-spec</module>
        <module>libo11y</module>
        <module>libo11y-test</module>
        <module>libo11y-micrometer</module>
        <module>libo11y-spring-boot-starter</module>
        <module>libo11y-cli</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-spec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ing.o11y</groupId>
                <artifactId>libo11y-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial,-try</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
