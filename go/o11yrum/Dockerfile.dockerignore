# The o11yrum-gateway image builds from go/ (see Dockerfile). Only the
# sources the command compiles are admitted: the core module's root
# package and the core packages the gateway imports, and the o11yrum
# module without its tests. When the gateway starts importing another core
# package, add it here; `make o11yrum-image` fails until then.
*
!go.mod
!go.sum
!*.go
!spec/*.go
!internal/appregistry/*.go
!internal/fanout/*.go
!internal/specrules/*.go
!internal/spectables/*.go
!o11yrum/go.mod
!o11yrum/go.sum
!o11yrum/**/*.go
**/*_test.go
